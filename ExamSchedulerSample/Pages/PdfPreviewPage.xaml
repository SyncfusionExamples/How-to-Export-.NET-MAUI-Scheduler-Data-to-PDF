<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pdf="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
    x:Class="ExamSchedulerSample.PdfPreviewPage"
    Title="Preview / Print">

    <Grid RowDefinitions="Auto,*" Padding="10">
        <HorizontalStackLayout Spacing="8">
            <Button Text="Print" Clicked="OnPrintClicked" />
            <Button Text="Close" Clicked="OnCloseClicked" />
        </HorizontalStackLayout>

        <!-- Keep it simple; we only load a MemoryStream we control -->
        <pdf:SfPdfViewer x:Name="Viewer" Grid.Row="1" />
    </Grid>
</ContentPage>
