<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:scheduler="clr-namespace:Syncfusion.Maui.Scheduler;assembly=Syncfusion.Maui.Scheduler"
    xmlns:local="clr-namespace:ExamSchedulerSample"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:Class="ExamSchedulerSample.SchedulePage">

    <ContentPage.BindingContext>
        <local:ScheduleViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" Padding="10">

        <HorizontalStackLayout Spacing="8">
            <Button Text="Export PDF" Clicked="OnExportPdfClicked"/>
            <Button Text="Preview/Print" Clicked="OnPreviewPrintClicked"/>
        </HorizontalStackLayout>

        <scheduler:SfScheduler
            Grid.Row="1"
            AppointmentsSource="{Binding Appointments}"
            View="TimelineWeek"
            DisplayDate="{Binding DisplayDate}">

            <scheduler:SfScheduler.AppointmentMapping>
                <scheduler:SchedulerAppointmentMapping
                    StartTime="Start"
                    EndTime="End"
                    Subject="Subject"
                    Notes="Notes"
                    Id="Id"
                    ResourceIds="ResourceIds"
                    Background="BackgroundBrush" />
            </scheduler:SfScheduler.AppointmentMapping>

            <scheduler:SfScheduler.TimelineView>
                <scheduler:SchedulerTimelineView
                    StartHour="8"
                    EndHour="18"
                    TimeInterval="01:00:00"
                    TimeIntervalWidth="120">

                    <scheduler:SchedulerTimelineView.AppointmentTemplate>
                        <DataTemplate>

                            <!-- IMPORTANT:
                                  In TimelineView, the correct binding for mapped background is:
                                  {Binding Appointment.Background}
                                  NOT simply {Binding Background} -->
                            <Border
                                Background="{Binding Appointment.Background}"
                                Stroke="#66000000"
                                StrokeThickness="1"
                                Padding="6">

                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">

                                    <Label
                                        Text="{Binding Subject}"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding Notes}"
                                        FontSize="11"
                                        TextColor="White"
                                        Opacity="0.95"
                                        LineBreakMode="TailTruncation" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </scheduler:SchedulerTimelineView.AppointmentTemplate>

                </scheduler:SchedulerTimelineView>
            </scheduler:SfScheduler.TimelineView>

        </scheduler:SfScheduler>

    </Grid>
</ContentPage>
