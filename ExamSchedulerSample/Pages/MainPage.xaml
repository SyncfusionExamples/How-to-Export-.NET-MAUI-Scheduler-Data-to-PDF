<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExamSchedulerSample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FB"
    Padding="24">

    <VerticalStackLayout
        Padding="40"
        Spacing="20"
        VerticalOptions="Center">

        <Label Text="Exam Scheduler"
               FontSize="32"
               HorizontalOptions="Center"
               FontAttributes="Bold" />

        <Button Text="Enter"
                x:Name="EnterButton"
                HeightRequest="50"
                Clicked="EnterButton_Clicked" />
    </VerticalStackLayout>

</ContentPage>